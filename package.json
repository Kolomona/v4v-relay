{
  "name": "v4v-relay",
  "version": "1.0.0",
  "description": "TypeScript IRC bot that relays messages from The Split Kit and boostagrams from Helipad",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "irc",
    "bot",
    "splitkit",
    "boostagram",
    "lightning",
    "value4value"
  ],
  "author": "Converted from splitkit-relay Python project",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.16.0",
    "dotenv": "^16.3.1",
    "express": "^4.22.1",
    "irc-framework": "^4.13.1",
    "socket.io-client": "^4.8.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.23",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^8.54.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
